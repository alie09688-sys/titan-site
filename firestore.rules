rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // متجر كل محل: القراءة للجميع (الزبائن)، والتعديل لصاحب المحل فقط
    match /shops/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && !('active' in request.resource.data)
                    && request.resource.data.invite is string
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.used == ''
                    && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.used == slug
                    && slug.matches('^[a-z0-9-]{3,30}$');
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.get('active', '') == resource.data.get('active', '')
                    && resource.data.get('active', '') != 'off';
    }

    // صور الكفرات: القراءة للجميع، والكتابة والحذف لصاحب المحل فقط
    match /shops/{slug}/items/{item} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && get(/databases/$(database)/documents/shops/$(slug)).data.owner == request.auth.uid
                            && get(/databases/$(database)/documents/shops/$(slug)).data.get('active', '') != 'off'
                            && request.resource.data.img is string
                            && request.resource.data.img.size() < 300000;
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/shops/$(slug)).data.owner == request.auth.uid;
    }

    // أكواد التفعيل: تنشئها أنت من Firebase، ويستهلكها العميل مرة واحدة فقط
    match /invites/{code} {
      allow get: if false;
      allow list: if false;
      allow update: if request.auth != null
                    && resource.data.used == ''
                    && request.resource.data.used is string
                    && request.resource.data.used != ''
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);
    }

    // ربط كل مستخدم بمتجره: لصاحبه فقط
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
